{
  "name": "firms-postgres-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "debezium_user",
    "database.dbname": "fire_analytics",
    "topic.prefix": "firms",
    "plugin.name": "pgoutput",
    "slot.name": "firms_detections_slot",
    "publication.name": "firms_detections_publication",
    "publication.autocreate.mode": "disabled",
    "table.include.list": "public.raw_firms_detections",
    "snapshot.mode": "initial"
  }
}
