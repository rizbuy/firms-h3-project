# Buat file .env lokal dari template dan isi MAP_KEY FIRMS.
FIRMS_MAP_KEY=replace_me
POSTGRES_PASSWORD=replace_with_a_long_random_password
DEBEZIUM_PASSWORD=replace_with_a_different_long_random_password
FIRMS_SOURCE=VIIRS_SNPP_NRT
FIRMS_AREA=94,-11,142,7
FIRMS_DAY_RANGE=1
# Isi kedua tanggal untuk backfill inklusif; rentang panjang dipecah otomatis menjadi batch 5 hari.
FIRMS_START_DATE=
FIRMS_END_DATE=
